# FakerAPI ingestion settings
# Production values live in /etc/api-monitor.env on the server, not in Git.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=api_monitor
DB_USER=api_monitor_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

FAKERAPI_BASE_URL=https://fakerapi.it/api/v1
API_RESOURCES=addresses,books,companies,persons,places,products,texts,users
API_QUANTITY=5
API_LOCALE=en_US
# Optional integer. Leave empty to get fresh generated values each sync.
API_SEED=
INTERVAL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=20
